# --- Build outputs & toolchains (regenerated locally, huge) ---
idf/
c6_light/
llama-bsl/
itead-bsl/
cc2538-bsl/
z2m/

# --- Python ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# --- Live runtime state (contains device/NV data, churns constantly) ---
data/
*.db
*.db-shm
*.db-wal

# --- Firmware binaries & dumps (vendor images, large; re-downloadable) ---
dongle-fw/fw.zip
dongle-fw/*.hex
dongle-fw/backups/

# --- Editor / OS ---
.vscode/
.idea/
*.swp
.DS_Store

# --- Secrets (never commit) ---
.env
.env.*
*.key
*.pem
